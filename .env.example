# Copy to .env and fill in. `.env` is gitignored — keep it that way.
# With OPENROUTER_API_KEY set, the `cloud` profile becomes the default
# (qwen3-embedding-8b for vectors, cohere/rerank-5-fast for reranking).
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides
# ZOTLENS_PROFILE=cloud            # cloud | local
# ZOTLENS_EMBED=api                # local | api
# ZOTLENS_EMBED_API_MODEL=qwen/qwen3-embedding-8b
# ZOTLENS_EMBED_API_DIM=1024
# ZOTLENS_RERANK=api               # local | api | llm | none
# ZOTLENS_RERANK_API_MODEL=cohere/rerank-5-fast
# ZOTLENS_LLM=deepseek             # deepseek | local
# ZOTERO_DIR=~/Zotero
